{
  "name": "maison-my",
  "packageManager": "yarn@4.5.0",
  "type": "module",
  "scripts": {
    "dev": "remix vite:dev",
    "build": "remix vite:build",
    "start": "npx remix-serve build/server/index.js",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "typecheck": "tsc",
    "test": "vitest --config ./vitest.config.ts",
    "test:ui": "vitest --ui --config ./vitest.config.ts",
    "clean": "rm -rf build",
    "emails": "email dev --dir app/emails"
  },
  "dependencies": {
    "@react-email/components": "^0.0.28",
    "@remix-run/node": "^2.15.0",
    "@remix-run/react": "^2.15.0",
    "@remix-run/serve": "^2.15.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.46.2",
    "@vercel/remix": "^2.14.0",
    "i18next": "^23.15.1",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-fs-backend": "^2.3.2",
    "i18next-http-backend": "^2.6.1",
    "isbot": "4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.2",
    "react-icons": "^5.3.0",
    "react-social-icons": "^6.18.0",
    "remix-i18next": "^6.4.1",
    "resend": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@remix-run/dev": "^2.15.0",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.10.0",
    "eslint-plugin-react": "^7.36.1",
    "globals": "^15.13.0",
    "prettier": "^3.3.3",
    "react-email": "3.0.2",
    "remix-development-tools": "^4.6.0",
    "sass-embedded": "^1.81.0",
    "supabase": "^2.0.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.6.0",
    "vite": "^5.4.6",
    "vite-tsconfig-paths": "^5.0.1"
  }
}
